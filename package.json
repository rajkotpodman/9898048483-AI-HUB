{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "dist:win": "next build && electron-builder --windows",
    "dist:mac": "next build && electron-builder --mac",
    "dist:linux": "next build && electron-builder --linux",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@supabase/supabase-js": "^2.112.0",
    "@types/adm-zip": "^0.5.8",
    "@webcontainer/api": "^1.6.4",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.11.0",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "xterm": "^5.3.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.4.9",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wait-on": "^9.1.0"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "^1.29.0",
    "lightningcss-darwin-x64": "^1.29.0",
    "lightningcss-linux-x64-gnu": "^1.29.0",
    "lightningcss-win32-x64-msvc": "^1.29.0"
  },
  "build": {
    "appId": "com.aihub.app",
    "productName": "9898048483 Android AI",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "main.js",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
